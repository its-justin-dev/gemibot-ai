# Copy to .env and fill in. .env is gitignored; this file is the documented template.
#
# electron-vite loads .env per target and only exposes these prefixes:
#   MAIN_VITE_     -> src/main      (import.meta.env)
#   PRELOAD_VITE_  -> src/preload   (import.meta.env)
#   RENDERER_VITE_ -> src/renderer  (import.meta.env)
#   VITE_          -> all three
#
# Everything with one of those prefixes is INLINED INTO THE BUNDLE at build time. Anyone who
# unpacks the app.asar can read it. Never put a secret here - use a runtime-only variable
# (no prefix) and read it from process.env inside the main process.

# ---- Build time, safe to ship ----
MAIN_VITE_APP_ENV=development
MAIN_VITE_API_BASE_URL=http://localhost:8787
RENDERER_VITE_APP_CHANNEL=local

# ---- Runtime only, main process, never bundled ----
# Read via process.env in src/main. In a packaged app this comes from the real environment,
# or from a .env placed in the userData folder.
#
# GEMINI_API_KEY is the one the Gemibot engine reads (v1.0 parity: GEMINI_API_KEY, else
# GOOGLE_API_KEY, else AppConstants.API_KEY in src/shared/constants/app-constants.ts).
GEMINI_API_KEY=
# Scaffold-only key used by src/main/services/config.service.ts; the engine never reads it.
GEMIBOT_API_KEY=
