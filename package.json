{
  "name": "gemibot-prototype",
  "version": "1.0.0",
  "description": "Gemibot desktop prototype built with Electron, electron-vite, React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Gemibot",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "dist": "npm run build && electron-builder",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "benchmark:build": "vitest run --config vitest.benchmark.config.mts"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "2.30.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "1.2.0",
    "diff": "9.0.0",
    "docx": "9.13.0",
    "edge-tts-universal": "1.4.0",
    "electron-log": "^5.4.4",
    "exceljs": "4.4.0",
    "he": "2.0.0",
    "jszip": "3.10.2",
    "lucide-react": "^1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "systeminformation": "5.33.16",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^3.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
